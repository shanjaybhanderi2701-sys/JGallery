<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MANAGE_EXTERNAL_STORAGE is declared by :core:storage and merged in — the app module
         itself declares no storage permissions (the boundary owns the permission model). -->

    <!-- NO network permission here (APP-637). Firebase Crashlytics is a DEBUG-ONLY testing aid; its
         INTERNET/ACCESS_NETWORK_STATE + firebase_* meta-data live in app/src/debug/AndroidManifest.xml
         so the shipped RELEASE/benchmark merged manifest carries zero network capability. This keeps
         the §9.3 "works fully on your device … never uploaded" guarantee TRUE for the shipped build
         (so the trust copy STAYS) — enforced by construction by the variant-aware egress guard
         (:app:verifyNoEgressRelease). See [APP-636] (debug-only decision) / [APP-289] (zero-egress). -->

    <!-- Delegated capture straight into an album (APP-424): JGallery hands a MediaStore EXTRA_OUTPUT
         uri to the *system camera* so the camera app writes the bytes. JGallery therefore declares NO
         CAMERA permission (declaring-but-ungranted would break ACTION_IMAGE_CAPTURE — Security gate
         APP-426). These <queries> give the capture intents package visibility on Android 11+ so the
         launcher resolves a camera app; absence is handled gracefully (ActivityNotFoundException → no-op). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".JGalleryApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.JGallery">

        <!-- No firebase_* meta-data here (APP-637). Crashlytics config is debug-only and lives in
             app/src/debug/AndroidManifest.xml, so the shipped release manifest declares no
             Crashlytics collection and merges no Crashlytics ContentProvider. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JGallery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
