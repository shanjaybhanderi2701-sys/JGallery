<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MANAGE_EXTERNAL_STORAGE is declared by :core:storage and merged in — the app module
         itself declares no storage permissions (the boundary owns the permission model). -->

    <!-- Network egress for Firebase Crashlytics (APP-614, board Option A / APP-613). Declared
         EXPLICITLY (not left to library-manifest merge) so the exact egress surface is auditable
         for the Play "Data safety" form (APP-616). These are the ONLY two network permissions the
         relaxed egress guard (APP-289) allows; every other network permission stays blocked at the
         merged-manifest check. Firebase Crashlytics/Analytics upload crash + telemetry data — the
         §9.3 "never uploaded" claim no longer holds and its copy is being pulled under APP-616,
         which gates the 1.0.0 Play upload (APP-517). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Delegated capture straight into an album (APP-424): JGallery hands a MediaStore EXTRA_OUTPUT
         uri to the *system camera* so the camera app writes the bytes. JGallery therefore declares NO
         CAMERA permission (declaring-but-ungranted would break ACTION_IMAGE_CAPTURE — Security gate
         APP-426). These <queries> give the capture intents package visibility on Android 11+ so the
         launcher resolves a camera app; absence is handled gracefully (ActivityNotFoundException → no-op). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".JGalleryApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.JGallery">

        <!-- APP-614 / Security review APP-618 Finding 2: board Option A (APP-613) approved crash
             reporting only. Firebase Analytics auto-collection, Advertising ID (AdID) and Android ID
             (SSAID) collection are DISABLED by default so the app collects crash data only, keeping
             the Play "Data safety" declaration (APP-616) minimal and truthful for a privacy-first
             file manager. Crashlytics reports via the datatransport pipeline independently of the
             Analytics measurement pipeline, so its collection (below, kept ON) is unaffected. If the
             board later wants product analytics at launch, flip these + update the Data-safety copy. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_ssaid_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JGallery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
